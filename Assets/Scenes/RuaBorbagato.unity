--- !u!114 &1711690687
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1711690680}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b3b8ce7125846ec44b179ed0f5a07dd5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  rumors:
  - rumorText: "\" Acho que ouvi os policiais afirmando ele ter pulado de cima do
      pr\xE9dio \""
    rumorTrueOrFalse: 1
    impactOnSuspeitometro: 1.46
    targetSuspeitometro: {fileID: 476952625}
    receiveTrueInfo: "Melhor investigar mais afundo, ele n\xE3o parecia algu\xE9m
      que se jogaria assim..."
    receiveFalseInfo: "Talvez os policiais estejam certos, eu n\xE3o conhecia ele
      muito bem, apesar de ele j\xE1 ter ido algumas vezes na minha loja"
  - rumorText: "\" O coitado aparecia vez ou outra na C\xE3oveni\xEAncia pedindo
      por milho de pipoca... \""
    rumorTrueOrFalse: 1
    impactOnSuspeitometro: 3.15
    targetSuspeitometro: {fileID: 0}
    receiveTrueInfo: "Afinal ele era o pipoqueiro do Cinema, voc\xEA n\xE3o vai encontrar
      nada l\xE1, exceto por um bom t\xEDtulo: \"Expresso Patinhas\""
    receiveFalseInfo: Um pouco estranho ele ir comprar milho, achava que o cinema
      fornecia isso pra ele...
  - rumorText: '" Quando eu visitava o Hamstel, aquela bartender sempre parecia meio
      bebada "'
    rumorTrueOrFalse: 0
    impactOnSuspeitometro: 4.1
    targetSuspeitometro: {fileID: 1366359697}
    receiveTrueInfo: "Talvez seja s\xF3 impress\xE3o, afinal podia ser cansa\xE7o
      de ter que lidar com os pingu\xE7os daquele lugar."
    receiveFalseInfo: "Os guardas deveriam fazer um exame toxicol\xF3gico nessa gata
      bebeada, tenho certeza que vi ela jogar uma garrafa fora agora de pouco."
  - rumorText: "\" Faz tempo que vivo aqui na Rua, o policial Kenai tem um bom hist\xF3rico,
      ele quase sempre resolvia os casos \""
    rumorTrueOrFalse: 0
    impactOnSuspeitometro: 1.95
    targetSuspeitometro: {fileID: 476952625}
    receiveTrueInfo: "Kenai geralmente acerta, mas dessa vez... tenho minhas d\xFAvidas."
    receiveFalseInfo: "Realmente, pelo que eu lembre ele tem bom faro pra esses crimes
      que acontecem por aqui, nunca \xE9 nada t\xE3o profundo."
  indexRumor: 0
  valueSus: 4.5
  canAppearRumor: 0

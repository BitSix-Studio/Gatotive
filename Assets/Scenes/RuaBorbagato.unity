--- !u!114 &476952632
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 476952625}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b3b8ce7125846ec44b179ed0f5a07dd5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  rumors:
  - rumorText: '" A bartender viu o que aconteceu melhor que aquela outra cachorra
      "'
    rumorTrueOrFalse: 1
    impactOnSuspeitometro: 4
    targetSuspeitometro: {fileID: 1366359697}
    receiveTrueInfo: "Tura Satana n\xE3o \xE9 t\xE3o louca quanto afirma..."
    receiveFalseInfo: "V\xE1 conversar com a cachorra de vestido ao final da Rua..."
  - rumorText: "\" Tenho a impress\xE3o que n\xE3o descobrimos tudo sobre essa investiga\xE7\xE3o
      ainda... \""
    rumorTrueOrFalse: 1
    impactOnSuspeitometro: 2
    targetSuspeitometro: {fileID: 1366359697}
    receiveTrueInfo: Analise o corpo de mais perto.
    receiveFalseInfo: Tente falar novamente com o Polcial Kenai.
  - rumorText: "\" \xC9 mais f\xE1cil acreditar naquela cachorra, ela parece estar
      mais preocupada com o incidente \""
    rumorTrueOrFalse: 0
    impactOnSuspeitometro: 5
    targetSuspeitometro: {fileID: 1711690680}
    receiveTrueInfo: "Apesar que... A gata parece ter mais certeza do que viu, ser\xE1?"
    receiveFalseInfo: Melhor conversar direto com a cachorra de vestido, ela deve
      saber bem mais sobre o que aconteceu...
  - rumorText: "\" O chefe Kenai concluiu um su\xEDcidio nesse incidente, o faro
      dele \xE9 impec\xE1vel com essas coisas! \""
    rumorTrueOrFalse: 0
    impactOnSuspeitometro: 3
    targetSuspeitometro: {fileID: 0}
    receiveTrueInfo: "Apesar que... \xE9 t\xE3o estranho como o corpo da v\xEDtima
      esconde tanto sobre o incidente, com certeza vale dar mais uma olhada..."
    receiveFalseInfo: "Melhor agilizar as coisas, tenho certeza que o Kenai est\xE1
      certo!"
  indexRumor: 0
  valueSus: 6
  canAppearRumor: 0

  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 11ae79541061fc542b877bd387e6995a, type: 3}
  m_Name: IntroPrincesa
  m_EditorClassIdentifier: 
  dialogues:
  - nomePersonagem: GATOTIVE
    imgPersonagem: {fileID: 21300000, guid: c75190298b7804f49b02fad590471618, type: 3}
    txtSpeak: Boa noite.
  - nomePersonagem: PRINCESA
    imgPersonagem: {fileID: 21300000, guid: 3d4f734b8dec2624fb52208f959fd9ed, type: 3}
    txtSpeak: ... Boa.
  - nomePersonagem: GATOTIVE
    imgPersonagem: {fileID: 21300000, guid: 40f6037b6110ab44f9b9c9b4767b0cb4, type: 3}
    txtSpeak: "(silenciosa, como sempre)\nEst\xE1 cuidando das testemunhas?"
  - nomePersonagem: PRINCESA
    imgPersonagem: {fileID: 21300000, guid: 0f11f5bcfd84a0d448dde4814e1178e4, type: 3}
    txtSpeak: 'Sim.

      Duas mulheres, na casa dos 20 anos.'
  - nomePersonagem: PRINCESA
    imgPersonagem: {fileID: 21300000, guid: 0f11f5bcfd84a0d448dde4814e1178e4, type: 3}
    txtSpeak: "A gata trabalha no pr\xE9dio que aconteceu o ocorrido.\nA cachorra
      \xE9 dona da loja de conveni\xEAncia que fica do lado do pr\xE9dio.\nAmbas
      presenciaram a cena."
  - nomePersonagem: GATOTIVE
    imgPersonagem: {fileID: 21300000, guid: c75190298b7804f49b02fad590471618, type: 3}
    txtSpeak: "Est\xE1 bem...\nAgrade\xE7o as informa\xE7\xF5es."
  - nomePersonagem: PRINCESA
    imgPersonagem: {fileID: 21300000, guid: b25d29a2d2ddb7342986f4f4b3dfacf4, type: 3}
    txtSpeak: "\xC9 o meu trabalho."

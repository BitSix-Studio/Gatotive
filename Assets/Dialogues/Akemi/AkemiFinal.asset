%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 11ae79541061fc542b877bd387e6995a, type: 3}
  m_Name: AkemiFinal
  m_EditorClassIdentifier: 
  dialogues:
  - nomePersonagem: AKEMI
    imgPersonagem: {fileID: 21300000, guid: 227d22ed24977dd49b53666df6efb9d7, type: 3}
    txtSpeak: Eae maninho? Conseguiu?
  - nomePersonagem: KURO
    imgPersonagem: {fileID: 21300000, guid: 40f6037b6110ab44f9b9c9b4767b0cb4, type: 3}
    txtSpeak: "Sim... era como eu pensava, realmente foi um assassinato, ele n\xE3o
      tinha porque se matar"
  - nomePersonagem: KURO
    imgPersonagem: {fileID: 21300000, guid: 855638f008c57564d8f5c53fa4058290, type: 3}
    txtSpeak: "Ent\xE3o... s\xF3 podia ser uma \xFAnica coisa, tinha realmente algu\xE9m
      junto com ele em cima do pr\xE9dio, e algu\xE9m o jogou de l\xE1, para eliminar
      suspeitas..."
  - nomePersonagem: AKEMI
    imgPersonagem: {fileID: 21300000, guid: 23cd4efe5f7238c4592bb079acf34402, type: 3}
    txtSpeak: "Suspeitas? Para o que? Ele n\xE3o era somente um cachorro qualquer?"
  - nomePersonagem: KURO
    imgPersonagem: {fileID: 21300000, guid: 40f6037b6110ab44f9b9c9b4767b0cb4, type: 3}
    txtSpeak: "Julgo que havia mais nesse cachorro, afinal ele perto de n\xF3s era
      um de ra\xE7a, ent\xE3o \xE9 poss\xEDvel que tenha algum envolvimento com os
      altos escal\xF5es da Rua Borbagato"
  - nomePersonagem: AKEMI
    imgPersonagem: {fileID: 21300000, guid: d461bfbe900513c459701ba699e7fe8f, type: 3}
    txtSpeak: "Com os de ra\xE7a? Nunca que eu misturo com um deles, vira lata do
      jeito que sou, mas o que vai fazer a partir dai?"
  - nomePersonagem: KURO
    imgPersonagem: {fileID: 21300000, guid: c75190298b7804f49b02fad590471618, type: 3}
    txtSpeak: "Vou investigar amanh\xE3 cedo, quando a poeira abaixar, agora vou
      ir dormir Akemi, boa noite!"
  - nomePersonagem: AKEMI
    imgPersonagem: {fileID: 21300000, guid: 23cd4efe5f7238c4592bb079acf34402, type: 3}
    txtSpeak: "Boa noite, tente n\xE3o dormir na mesa do seu escrit\xF3rio de novo,
      eu quem tive que limpar sua baba de l\xE1 da \xFAltima vez."
